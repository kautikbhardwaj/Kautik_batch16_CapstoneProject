# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DATABASE_URL=sqlite:///./devops_costs.db

# Multi-Cloud Sync Mode
# Automatically falls back to realistic synthetic multi-cloud data if credentials are empty
MOCK_CLOUD_MODE=true
SYNC_INTERVAL_HOURS=24

# AWS Credentials (AWS Cost Explorer & CloudWatch)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Azure Credentials (Azure Cost Management & Azure Monitor)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# GCP Credentials (GCP Cloud Billing & Cloud Monitoring)
GCP_PROJECT_ID=
GCP_BILLING_ACCOUNT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Alerting & Notification Integrations
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
ALERTMANAGER_URL=http://localhost:9093

# Cost Thresholds (Default alert triggers)
DAILY_COST_SPIKE_THRESHOLD_PCT=25.0
MONTHLY_BUDGET_LIMIT_USD=10000.0
HIGH_CPU_THRESHOLD_PCT=85.0
IDLE_CPU_THRESHOLD_PCT=5.0
